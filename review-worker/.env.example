# review-worker — salin jadi .env lalu isi (notepad .env). File .env TIDAK di-commit. Jangan tulis password DB di sini.

# --- Supabase CS Tracker (wajib untuk antrian website) — kunci service role HANYA di laptop ini
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Hakim AI: Claude Haiku 5.5 lewat Anthropic API langsung (kosong = AI mati, hasil "butuh cek manusia", website tetap jalan)
ANTHROPIC_API_KEY=
REVIEW_MODEL=claude-haiku-5-5
REVIEW_EFFORT=medium
# batas biaya AI per hari (USD, tanggal WIB). Terlewati → uji berhenti otomatis, bisa dilanjutkan besok
REVIEW_DAILY_BUDGET_USD=2
# di bawah ini (0-100) saran AI otomatis jadi "butuh cek manusia"
REVIEW_MIN_CONFIDENCE=70
# versi rubrik (kosong = terbaru di folder rubrik/)
REVIEW_RUBRIK=

# --- DB replika Konten.com (READ-ONLY, lewat VPN). Biasanya SUDAH ada di Windows sebagai env (PGHOST dst.) + pgpass.conf.
# Kosongkan kalau sudah di-set di Windows. Password TIDAK ditulis di sini (pakai %APPDATA%\postgresql\pgpass.conf).
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGSSLMODE=

# --- Unduh video (yt-dlp): batas laju, ukuran maks, jeda antar video
REVIEW_DL_RATE=4M
REVIEW_DL_MAX_MB=200
REVIEW_DL_JEDA=3

# --- Mesin media
# faster-whisper (kosong cache = pakai cache model voice-worker kalau ada)
REVIEW_WHISPER_MODEL=large-v3-turbo
REVIEW_WHISPER_CACHE=
# easyocr / mati
REVIEW_OCR=easyocr
# panako / olaf / chroma / mati
REVIEW_MUSIK=panako
# 1 = pisahkan vokal pakai Demucs saat kecocokan musik rendah (lebih lambat)
REVIEW_DEMUCS=0
# kosong = cari otomatis (tools\jdk lalu PATH)
REVIEW_JAVA=
REVIEW_PANAKO_JAR=

# --- Materi referensi Google Drive (link publik otomatis via gdown). Opsional: API key Google Drive (gratis) untuk folder besar
GOOGLE_DRIVE_API_KEY=
REVIEW_MATERI_MAX_MB=300

# --- Laporan: kurs & perkiraan volume
REVIEW_KURS_IDR=18000
REVIEW_VIDEO_PER_HARI=2000

# --- Lain-lain
# kosong = dibuat otomatis sekali (data/salt.txt). Dipakai menyamarkan id reviewer jadi R-xxxxxx
REVIEW_PSEUDONYM_SALT=
# folder kunci GPU bersama dengan voice-worker (kosong = bawaan %LOCALAPPDATA%\HotIssueKonten\gpu)
HOTISSUE_GPU_DIR=
