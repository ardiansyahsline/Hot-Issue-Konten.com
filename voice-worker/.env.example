# Salin jadi file ".env" di folder voice-worker (install.ps1 melakukannya otomatis), lalu isi.
# File .env HANYA ada di laptop. JANGAN di-commit / dikirim ke chat / ditaruh di website.

# --- WAJIB: Supabase (Dashboard Supabase > Project Settings > API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# "service_role" key (rahasia, punya akses penuh). Hanya untuk worker di laptop ini.
SUPABASE_SERVICE_ROLE_KEY=

# --- Opsional ---
# nama worker yang tampil di website (bawaan: laptop-<nama komputer>)
WORKER_ID=
# urutan mesin suara: chatterbox (GPU) lalu pocket (CPU)
ENGINE_ORDER=chatterbox,pocket
# model suara (biarkan bawaan kecuali tahu yang dilakukan)
CHATTERBOX_REPO=grandhigh/Chatterbox-TTS-Indonesian
CHATTERBOX_BASE_REPO=ResembleAI/chatterbox
# folder model Chatterbox yang sudah diunduh manual (kosongkan = unduh otomatis dari HuggingFace)
CHATTERBOX_DIR=
POCKET_REPO=tryzz889/pocket-tts-indonesian
# path / hf:// ke file .yaml pocket-tts kalau pemuat otomatis gagal
POCKET_CONFIG=
# token HuggingFace (hanya kalau model butuh login / sering kena batas unduh)
HF_TOKEN=
# model cek ucapan: tiny / base / small / medium (lebih besar = lebih akurat, lebih berat)
WHISPER_MODEL=small
# auto / cuda / cpu
WHISPER_DEVICE=auto
# batas thread CPU (laptop juga dipakai bot WAHA) — 4 sudah cukup
CPU_THREADS=4
# jumlah versi per baris untuk job TANPA setelan (1-4, bawaan 3). Website Studio selalu meminta 3 versi, jadi angka ini tidak
# mengubah job dari website. Tiap baris dibatasi waktu: versi ke-3 dst. otomatis dilewati kalau laptop lambat (minimal 2 versi)
TAKES=3
# batas atas peredaman bising DeepFilterNet. Yang dipakai otomatis menyesuaikan rekaman: bersih → ringan (6 dB), bising → maks angka ini
DF_ATTEN_DB=18
# skor kealamian (UTMOS, gratis) untuk memilih versi suara yang paling tidak "kayak AI". 1 = nyala, 0 = mati
# (pertama kali mengunduh ±410 MB dari GitHub; tanpa internet otomatis mati sendiri, suara tetap dibuat)
NATURAL_MOS=1
# render MP4 di laptop (butuh Node.js + install.ps1)
RENDER_ENABLED=1
# tab Chrome render paralel: angka 1-8, atau auto = setengah jumlah core CPU (2-4). Bawaan 2
RENDER_CONCURRENCY=2
RENDER_TIMEOUT_MIN=40
# path chrome-headless-shell sendiri (kosongkan = Remotion mengunduh otomatis saat render pertama)
REMOTION_BROWSER=
# --- RENDER-GPU ---
# render pakai GPU NVIDIA (laptop Intel + NVIDIA): auto = kalau ada NVIDIA, Chrome render diatur ke GPU "High performance" di Windows
# (tanpa admin) + gambar lewat ANGLE + encode video NVENC; gagal → otomatis diulang dengan encode CPU. nvidia = paksa walau nvidia-smi
# tidak terbaca. off = seperti dulu (tanpa pengaturan GPU)
RENDER_GPU=auto
# kualitas video saat encode NVENC (NVENC tidak memakai CRF): 10M = 10 Mbit/s, cukup untuk video 1080p 30 fps. Format: angka + K/M
RENDER_BITRATE=10M
# lepas model dari VRAM setelah menganggur N menit (0 = tidak pernah — model tetap di GPU selama worker hidup, job langsung jalan)
IDLE_UNLOAD_MIN=0

# --- RUNTIME --- (alur worker)
# 1 = saat worker mulai, mesin suara + cek ucapan + penilai kealamian dimuat & dipanaskan di LATAR (antrian tetap dicek; job yang
# datang menunggu sebentar) → job pertama tidak menunggu muat model ±30 dtk. mati = dimuat saat job pertama
PRELOAD=1
# cek antrian tiap N detik saat menganggur (sesudah job: tiap 1 dtk selama 1 menit; menganggur > 30 menit: minimal 10 dtk)
POLL_SEC=5
# jumlah unggahan ke penyimpanan Supabase yang jalan bersamaan (mp3 tiap kalimat diunggah sambil kalimat berikutnya dibuat)
UPLOAD_WORKERS=3
# 1 = log bersih (peringatan library yang tidak penting & progress bar disembunyikan), 0 = tampilkan semua (untuk cari masalah)
QUIET_LOG=1

# untuk freesound_cc0.py (daftar gratis: https://freesound.org/apiv2/apply)
FREESOUND_API_KEY=
# folder SFX Sonniss untuk tambah_sfx.py
SFX_DIR=C:\Konten.com\STUDIO-FX
