# Ambil dari Supabase: Project Settings > API (atau "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...   # anon / publishable key

# RAHASIA — hanya untuk halaman Admin (buat akun agent). Jangan pernah dibagikan.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...       # service_role / secret key

# Kontak dianggap HOT kalau muncul di >= angka ini issue dalam 30 hari terakhir
NEXT_PUBLIC_HOT_THRESHOLD=2

# Foto asli untuk AI (opsional, gratis). Kosong = otomatis pakai pencarian gambar web (SerpApi/Tavily),
# lalu ilustrasi SVG. Diisi di Vercel → langsung aktif tanpa ubah kode.
# Unsplash: https://unsplash.com/developers (Access Key) · Pexels: https://www.pexels.com/api/
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
