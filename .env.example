# Ambil dari Supabase: Project Settings > API (atau "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...   # anon / publishable key

# RAHASIA — hanya untuk halaman Admin (buat akun agent). Jangan pernah dibagikan.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...       # service_role / secret key

# Kontak dianggap HOT kalau muncul di >= angka ini issue dalam 30 hari terakhir
NEXT_PUBLIC_HOT_THRESHOLD=2

# Foto asli untuk AI (opsional, gratis). Kosong = otomatis pakai pencarian gambar web (SerpApi/Tavily),
# lalu ilustrasi SVG. Diisi di Vercel → langsung aktif tanpa ubah kode.
# Unsplash: https://unsplash.com/developers (Access Key) · Pexels: https://www.pexels.com/api/
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Riset internet (opsional, gratis 1.000 kredit/bulan dari https://tavily.com). Dipakai tab ✨ AI (cari & baca web) dan
# sutradara Studio (riset subjek sebelum bikin rencana video). Kosong = tetap jalan, hanya tanpa riset internet.
TAVILY_API_KEY=
# Alamat server Tavily (biarkan kosong = https://api.tavily.com)
TAVILY_BASE_URL=

# ---------- Studio Pro (menu 🎬 Studio) — semua opsional ----------
# Cari SFX dari Freesound langsung di website (hanya lisensi CC0, bebas dipakai). Kosong = tombol cari SFX tidak muncul.
# Daftar gratis: https://freesound.org/apiv2/apply
FREESOUND_API_KEY=
# Suara "⭐ Premium" ElevenLabs (berbayar, dari elevenlabs.io). Kosong = pilihan Premium tidak muncul.
ELEVENLABS_API_KEY=
# id suara ElevenLabs yang dipakai. Kosong = suara pertama di akun ElevenLabs.
ELEVENLABS_VOICE_ID=
# Batas pakai mesin AI berat di Studio per user per hari (pemilik AI tidak dibatasi). Kosong = ikut
# AI_HEAVY_DAILY_LIMIT (batas tab ✨ AI); kalau itu juga kosong, bawaan 15. 0 = selain pemilik AI tidak bisa pakai mesin berat.
AI_STUDIO_HEAVY_DAILY_LIMIT=15
# Lisensi Remotion (pembuat video). Perorangan / perusahaan ≤ 3 orang: biarkan kosong (gratis).
# Perusahaan > 3 orang wajib beli lisensi (https://remotion.dev/license), lalu isi kuncinya di sini.
NEXT_PUBLIC_REMOTION_LICENSE_KEY=
